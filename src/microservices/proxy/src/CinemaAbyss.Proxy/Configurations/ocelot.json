{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/movies",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "monolith", "Port": 8080 },
        { "Host": "movies-service", "Port": 8081 }
      ],
      "UpstreamPathTemplate": "/api/movies",
      "UpstreamHttpMethod": ["GET", "POST"],
      "LoadBalancerOptions": { "Type": "PercentageBalancer", "Key": "7,3" }
    },
    {
      "DownstreamPathTemplate": "/api/users",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "monolith", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/users",
      "UpstreamHttpMethod": ["GET", "POST"]
    },
    {
      "DownstreamPathTemplate": "/api/payments",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "monolith", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/payments",
      "UpstreamHttpMethod": ["GET", "POST"]
    },
    {
      "DownstreamPathTemplate": "/api/subscriptions",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "monolith", "Port": 8080 }],
      "UpstreamPathTemplate": "/api/subscriptions",
      "UpstreamHttpMethod": ["GET", "POST"]
    },
    {
      "DownstreamPathTemplate": "/api/events/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "events-service", "Port": 8082 }],
      "UpstreamPathTemplate": "/api/events/{everything}",
      "UpstreamHttpMethod": ["GET", "POST", "PUT", "DELETE"]
    },
    {
      "DownstreamPathTemplate": "/api/movies/health",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [{ "Host": "movies-service", "Port": 8081 }],
      "UpstreamPathTemplate": "/api/movies/health",
      "UpstreamHttpMethod": ["GET"]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8000"
  }
}
