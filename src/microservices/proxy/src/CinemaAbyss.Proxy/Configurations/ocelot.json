{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/movies",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "monolith",
          "Port": 8080
        },
        {
          "Host": "movies-service",
          "Port": 8081
        }
      ],
      "UpstreamPathTemplate": "/api/movies",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "LoadBalancerOptions": {
        "Type": "PercentageBalancer",
        "Key": "7,3"
      },
      "Metadata": {
        "tags": "tag1,tag2,internal,api",
        "environment": "production",
        "custom-key": "value"
      },
      "Tags": [
        "products",
        "catalog",
        "v1"
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8000"
  }
}